{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "SMART_ENTRY_DB_PATH",
        "SMART_ENTRY_ZIGBEE_PORT",
        "SMART_ENTRY_FAKE_DELAY_MS",
        "SMART_ENTRY_FAKE_UNREACHABLE",
        "SMART_ENTRY_TRANSPORT",
        "SMART_ENTRY_LOW_MEMORY_BUILD",
        "SMART_ENTRY_ZIGBEE_URL",
        "ADMIN_PASSWORD_HASH",
        "SESSION_SECRET",
        "NODE_ENV"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "zigbee#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
