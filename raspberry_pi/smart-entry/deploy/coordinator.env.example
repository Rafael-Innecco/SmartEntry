# Bench tools only; the HTTP bridge still uses SMART_ENTRY_TRANSPORT=fake.
# Copy to /etc/smart-entry/coordinator.env; smart-entry:smart-entry, mode 600.
# Replace this path with the actual output of ls -l /dev/serial/by-id/.
SMART_ENTRY_ZIGBEE_SERIAL_PATH=/dev/serial/by-id/REPLACE_WITH_ACTUAL_DEVICE
# Confirmed on this ANT-DONGLE: TI ZNP 2.7.1, revision 20240710, 115200 baud.
SMART_ENTRY_ZIGBEE_ADAPTER=zstack
SMART_ENTRY_ZIGBEE_BAUD_RATE=115200
SMART_ENTRY_ZIGBEE_STATE_DIR=/var/lib/smart-entry/zigbee
# Required for pair and probe. Use the ESP32-H2 IEEE address, not its short address.
# SMART_ENTRY_LOCK_IEEE=0x0123456789abcdef
