[Unit]
Description=SmartEntry web panel
After=network.target smart-locker-zigbee.service
Wants=smart-locker-zigbee.service

[Service]
Type=simple
User=smart-entry
Group=smart-entry
WorkingDirectory=/opt/smart-entry/apps/web
Environment=NODE_ENV=production
EnvironmentFile=/etc/smart-entry/web.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/smart-entry/apps/web/.next

[Install]
WantedBy=multi-user.target
