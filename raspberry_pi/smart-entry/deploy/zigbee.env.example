# /etc/smart-entry/zigbee.env, root:root, mode 600.
SMART_ENTRY_DB_PATH=/var/lib/smart-entry/smart-entry.sqlite3
SMART_ENTRY_ZIGBEE_PORT=4000
# Keep fake until the ESP implements docs/protocolo-zigbee-v1.md and hardware validation passes.
SMART_ENTRY_TRANSPORT=fake

# Proposed v1 real transport (explicit opt-in; not compatible with current example firmware):
# SMART_ENTRY_TRANSPORT=zigbee
# SMART_ENTRY_ZIGBEE_PROTOCOL=smart-entry-v1
# SMART_ENTRY_ZIGBEE_SERIAL_PATH=/dev/serial/by-id/REPLACE_WITH_ACTUAL_DEVICE
# SMART_ENTRY_ZIGBEE_ADAPTER=zstack
# SMART_ENTRY_ZIGBEE_BAUD_RATE=115200
# SMART_ENTRY_ZIGBEE_STATE_DIR=/var/lib/smart-entry/zigbee
# SMART_ENTRY_LOCK_IEEE=0x0123456789abcdef
# SMART_ENTRY_LOCK_HMAC_KEY_PATH=/etc/smart-entry/lock-hmac.key
# Key: exactly 32 raw bytes, readable only by smart-entry (mode 600).
